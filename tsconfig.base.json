{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Root directory for compilation
    "rootDir": "./src",

    // Disable options incompatible with emit
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib", "**/*.spec.ts"]
}
